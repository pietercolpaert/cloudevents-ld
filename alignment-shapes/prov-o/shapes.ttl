# Target shapes for converting CloudEvents-LD to PROV-O.
#
# These shapes describe the graph that a conversion (e.g. eyemind with OWL 2 RL over
# terms.ttl and alignments.ttl) must produce from CloudEvents-LD. See README.md in this
# folder for the mapping.
#
# Model: the CloudEvent is the record (prov:Entity); what happened is a separate
# occurrence (prov:Activity), linked with ce:describesOccurrence. PROV-O has no property
# for "a record describes an activity", so the CloudEvents-LD property is kept.
#
# OWL 2 RL derives the record, and its producer when ce:producedBy is known. It cannot
# create the occurrence: its rules only add triples between existing nodes. So the
# occurrence is optional here; when data does describe one, for example as a Linked
# Data enrichment, these shapes check it.
#
# Types are stated as property shapes on rdf:type (sh:hasValue), not as a node-level
# sh:class: eyemind reads the property shapes of --shacl-out as the triples it must
# derive, so this also asks the reasoner for the type triples.

@prefix ce:     <https://w3id.org/cloudevents#> .
@prefix ceprov: <https://w3id.org/cloudevents/alignment-shapes/prov-o#> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix dct:    <http://purl.org/dc/terms/> .

<https://w3id.org/cloudevents/alignment-shapes/prov-o> a owl:Ontology ;
    dct:title "CloudEvents-LD to PROV-O: target shapes (proposal)"@en ;
    rdfs:seeAlso <https://www.w3.org/TR/prov-o/> , <https://w3id.org/cloudevents> .

# ---------------------------------------------------------------------------
# The event record
# ---------------------------------------------------------------------------

ceprov:EventShape a sh:NodeShape ;
    rdfs:label "Event record"@en ;
    rdfs:comment
      "Every CloudEvent is a prov:Entity that describes at most one occurrence. Targeting the subjects of ce:id checks that the conversion covered every event in the input."@en ;
    sh:targetClass ce:CloudEvent ;
    sh:targetSubjectsOf ce:id, ce:describesOccurrence ;
    sh:property [
        sh:path rdf:type ; sh:hasValue prov:Entity ;
        sh:message "A CloudEvent must be typed prov:Entity."@en ] ;
    sh:property [
        sh:path ce:describesOccurrence ; sh:maxCount 1 ;
        sh:message "A CloudEvent describes at most one occurrence."@en ] ;
    sh:property [
        sh:path prov:generatedAtTime ; sh:maxCount 1 ;
        sh:or ( [ sh:datatype xsd:dateTime ] [ sh:datatype xsd:dateTimeStamp ] ) ;
        sh:message "prov:generatedAtTime (from ce:recordedtime) occurs at most once, as an xsd:dateTime or xsd:dateTimeStamp."@en ] ;
    sh:property [
        sh:path prov:wasAttributedTo ;
        sh:class prov:Agent ;
        sh:message "The producer of the record (from ce:producedBy) must be a prov:Agent."@en ] .

# ---------------------------------------------------------------------------
# The occurrence
# ---------------------------------------------------------------------------

ceprov:OccurrenceShape a sh:NodeShape ;
    rdfs:label "Occurrence"@en ;
    rdfs:comment
      "What happened, as a prov:Activity. A CloudEvent records an instant, so start and end time are equal."@en ;
    sh:targetObjectsOf ce:describesOccurrence ;
    sh:property [
        sh:path rdf:type ; sh:hasValue prov:Activity ;
        sh:message "An occurrence must be typed prov:Activity."@en ] ;
    sh:property [
        sh:path prov:startedAtTime ; sh:maxCount 1 ;
        sh:or ( [ sh:datatype xsd:dateTime ] [ sh:datatype xsd:dateTimeStamp ] ) ;
        sh:equals prov:endedAtTime ;
        sh:message "prov:startedAtTime (from ce:time) occurs at most once, is an xsd:dateTime or xsd:dateTimeStamp, and equals prov:endedAtTime."@en ] ;
    sh:property [
        sh:path prov:endedAtTime ; sh:maxCount 1 ;
        sh:or ( [ sh:datatype xsd:dateTime ] [ sh:datatype xsd:dateTimeStamp ] ) ;
        sh:message "prov:endedAtTime (from ce:time) occurs at most once and is an xsd:dateTime or xsd:dateTimeStamp."@en ] ;
    sh:property [
        sh:path prov:atLocation ; sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class prov:Location ;
        sh:message "prov:atLocation (from an absolute ce:source) occurs at most once and is an IRI typed prov:Location."@en ] ;
    sh:property [
        sh:path prov:wasAssociatedWith ;
        sh:class prov:Agent ;
        sh:message "Agents associated with the occurrence must be prov:Agents."@en ] ;
    sh:property [
        sh:path prov:used ;
        sh:class prov:Entity ;
        sh:message "Entities used by the occurrence must be prov:Entities."@en ] ;
    sh:property [
        sh:path prov:generated ;
        sh:class prov:Entity ;
        sh:message "Entities generated by the occurrence must be prov:Entities."@en ] ;
    sh:property [
        sh:path prov:invalidated ;
        sh:class prov:Entity ;
        sh:message "Entities invalidated by the occurrence must be prov:Entities."@en ] .
