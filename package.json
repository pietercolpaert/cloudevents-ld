{
  "name": "cloudevents-ld",
  "version": "0.1.0",
  "private": true,
  "description": "A Linked Data vocabulary, JSON-LD context and SHACL shapes for CloudEvents",
  "license": "EUPL-1.2",
  "type": "module",
  "scripts": {
